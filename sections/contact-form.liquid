<section class="section section--tight" aria-label="{{ section.settings.heading }}">
  <div class="page-width">
    <div class="contact-grid">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 style="margin-bottom:1rem">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        <div class="contact-info__block" style="margin-top:1.5rem">
          <h3 class="value__title">{{ 'sections.contact.email_title' | t }}</h3>
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        </div>
      </div>
      <div>
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">{{ 'sections.contact.success' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="form-status form-status--error" role="alert">{{ 'sections.contact.error' | t }}</p>
            {%- endif -%}
            <div class="field">
              <label class="field__label" for="ContactName">{{ 'sections.contact.name' | t }}</label>
              <input class="field__input" type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div class="field">
              <label class="field__label" for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
              <input class="field__input" type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            </div>
            <div class="field">
              <label class="field__label" for="ContactMessage">{{ 'sections.contact.message' | t }}</label>
              <textarea class="field__input" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="btn btn--primary">{{ 'sections.contact.submit' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We reply personally." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about the collection, your ritual, or an order — write to us. A person reads every message.</p>" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "hello@pawsitive.living", "info": "Update with the real support address before launch." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
