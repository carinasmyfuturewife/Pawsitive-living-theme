<section class="section section--tight" aria-label="{{ section.settings.heading }}">
  <div class="page-width page-width--narrow">
    <div class="section__head text-center">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="accordion" data-accordion>
        {%- for block in section.blocks -%}
          <div class="accordion__item" {{ block.shopify_attributes }}>
            <h3 style="margin:0">
              <button type="button" class="accordion__btn" aria-expanded="false" aria-controls="pfaq-{{ section.id }}-{{ forloop.index }}">
                {{ block.settings.question }}
                <span class="accordion__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="accordion__panel" id="pfaq-{{ section.id }}-{{ forloop.index }}" role="region">
              <div class="accordion__panel-inner rte">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I use it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Use as part of your daily ritual. A little goes a long way.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "Is it fragrance-free?", "answer": "<p>Yes. We do not use fragrance, essential oils, or masking agents.</p>" } },
        { "type": "qa", "settings": { "question": "How often should I use it?", "answer": "<p>Daily, as part of your ritual. Consistency matters more than quantity.</p>" } }
      ]
    }
  ]
}
{% endschema %}
