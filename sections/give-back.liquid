<section class="section section--dark giveback" aria-label="{{ section.settings.heading }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <p class="giveback__figure" aria-label="$2 from every order">$2<span class="sage-dot">.</span></p>
    <h2 style="margin-bottom:1rem">{{ section.settings.heading }}</h2>
    <p class="giveback__text">{{ section.settings.text }}</p>
    {%- if section.settings.link_label != blank -%}
      <p><a class="btn btn--outline-light" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>
    {%- endif -%}
    <p class="giveback__note" style="margin-top:1.5rem">{{ 'sections.give_back.partner_note' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Give-back",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our impact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From every order, to animal welfare." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "$2 from every order goes to animal welfare. Measurable, verifiable, and part of every purchase — not an afterthought." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Our impact" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Give-back" }]
}
{% endschema %}
