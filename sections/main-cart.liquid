{% comment %} Full-page cart — fallback when JavaScript is unavailable. The drawer handles the JS experience. {% endcomment %}
<section class="page" aria-label="{{ 'sections.cart.title' | t }}">
  <div class="page-width">
    <div class="page__head">
      <h1>{{ 'sections.cart.title' | t }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr>
              <th scope="col" colspan="2">{{ 'sections.cart.product' | t }}</th>
              <th scope="col">{{ 'sections.cart.quantity' | t }}</th>
              <th scope="col" style="text-align:right">{{ 'sections.cart.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td class="cart-table__media">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title | escape }}
                  {%- endif -%}
                </td>
                <td>
                  <p style="font-family:var(--font-display);font-size:1.125rem;margin-bottom:0.25rem">
                    <a href="{{ item.url }}" style="text-decoration:none">{{ item.product.title }}</a>
                  </p>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <p style="font-size:0.875rem;color:var(--color-ink-soft)">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  <button type="submit" name="updates[{{ item.key }}]" value="0" class="cart-item__remove">
                    {{ 'sections.cart.remove' | t }}
                  </button>
                </td>
                <td>
                  <span class="qty">
                    <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" aria-label="{{ 'sections.cart.quantity_for' | t: title: item.product.title }}" style="width:3.5rem">
                  </span>
                </td>
                <td style="text-align:right">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <div class="cart-summary">
          <p class="cart-drawer__subtotal"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="cart-drawer__note">{{ 'sections.cart.taxes_note' | t }}</p>
          <div class="cart-drawer__actions">
            <button type="submit" name="update" class="btn btn--secondary btn--full">{{ 'sections.cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary btn--full">{{ 'sections.cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <p style="margin-top:1rem"><a class="btn btn--secondary" href="{{ routes.collections_url }}">{{ 'sections.cart.continue' | t }}</a></p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
