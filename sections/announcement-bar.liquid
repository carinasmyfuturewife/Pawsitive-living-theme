<div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" style="color:inherit;text-decoration:none"><p>{{ section.settings.text }}</p></a>
  {%- else -%}
    <p>{{ section.settings.text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Announcement text", "default": "Complimentary shipping on orders over $50" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
