{% comment %}
  Ingredient standards — the standards behind every formula.
  Design doc §10 (homepage order). Honest: no ingredient is named;
  standards only, until formulations are validated.
{% endcomment %}
<section class="section standards" aria-label="{{ section.settings.heading }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="section__heading">{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 0 -%}
      <div class="standards-grid">
        {%- for block in section.blocks -%}
          <div class="standard" {{ block.shopify_attributes }}>
            <h3 class="standard__title">{{ block.settings.title }}</h3>
            <p class="standard__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredient standards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our standards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Held to a higher standard." }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fragrance-free" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "No fragrance, no essential oils, no masking agents. Nothing your dog did not ask for." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient standards",
      "blocks": [
        { "type": "standard", "settings": { "title": "Fragrance-free", "text": "No fragrance, no essential oils, no masking agents. Nothing your dog did not ask for." } },
        { "type": "standard", "settings": { "title": "Every ingredient earns its place", "text": "Nothing fashionable, nothing filler. If it is in the formula, it has a job." } },
        { "type": "standard", "settings": { "title": "Verified before published", "text": "Final ingredient lists appear here only once formulations are validated. Nothing listed until it is verified." } },
        { "type": "standard", "settings": { "title": "Tested like it matters", "text": "Stability, compatibility, and preservation testing before anything reaches your dog." } }
      ]
    }
  ]
}
{% endschema %}
