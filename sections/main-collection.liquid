<section class="section" aria-label="{{ collection.title }}">
  <div class="page-width">
    <div class="collection-head">
      <p class="eyebrow">{{ 'collections.general.eyebrow' | t }}</p>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte" style="margin-top:1rem">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-toolbar">
          <span class="collection-head__count">{{ 'collections.general.count' | t: count: collection.products_count }}</span>
          <label class="visually-hidden" for="SortBy">{{ 'collections.general.sort' | t }}</label>
          <select id="SortBy" onchange="location.href=this.value" aria-label="{{ 'collections.general.sort' | t }}">
            {%- for option in collection.sort_options -%}
              <option value="?sort_by={{ option.value }}"{% if collection.sort_by == option.value %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>

        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product_card_product: product, show_quick_add: true %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.accessibility.pagination' | t }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.accessibility.previous' | t }}">&larr;</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="{{ 'general.accessibility.next' | t }}">&rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="text-center" style="color:var(--color-ink-soft)">{{ 'collections.general.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 }
  ]
}
{% endschema %}
