{% comment %}
  Reviews — customer testimonials with star ratings.
  Replace the placeholder reviews with verified customer reviews before launch.
{% endcomment %}
<section class="reviews" aria-label="{{ section.settings.heading | escape }}">
  <div class="reviews__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow text-center">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="reviews__heading text-center">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="reviews__text text-center">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        <figure class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <span class="star{% if i <= block.settings.rating %} star--filled{% endif %}" aria-hidden="true">★</span>
            {%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="review-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <blockquote class="review-card__text">{{ block.settings.text }}</blockquote>
          <figcaption class="review-card__author">
            {%- if block.settings.author != blank -%}{{ block.settings.author }}{%- endif -%}
            {%- if block.settings.detail != blank -%}<span class="review-card__detail">{{ block.settings.detail }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rituals, kept." },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>Early notes from the dogs — and people — living the ritual.</p>" },
    { "type": "header", "content": "Replace the placeholder reviews below with verified customer reviews before launch." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author name" },
        { "type": "text", "id": "detail", "label": "Author detail", "info": "e.g. Golden Retriever owner" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Placeholder — replace with a real review",
            "text": "This is a placeholder review. Replace it with a verified customer review before launch.",
            "author": "Example Customer",
            "detail": "Breed owner"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Placeholder — replace with a real review",
            "text": "This is a placeholder review. Replace it with a verified customer review before launch.",
            "author": "Example Customer",
            "detail": "Breed owner"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Placeholder — replace with a real review",
            "text": "This is a placeholder review. Replace it with a verified customer review before launch.",
            "author": "Example Customer",
            "detail": "Breed owner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
