{%- assign fp = section.settings.product -%}
<section class="section{% if section.settings.alt_background %} section--alt{% endif %}" aria-label="{{ section.settings.heading }}">
  <div class="page-width">
    <div class="feature__grid{% if section.settings.reverse %} feature--reverse{% endif %}">
      <div class="feature__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            loading: 'lazy', widths: '600, 900, 1200',
            alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- elsif fp and fp.featured_media -%}
          {{ fp.featured_media | image_url: width: 1200 | image_tag:
            loading: 'lazy', widths: '600, 900, 1200',
            alt: fp.featured_media.alt | default: fp.title | escape
          }}
        {%- else -%}
          <span class="feature__media--placeholder" aria-hidden="true">{{ 'sections.product_feature.image_soon' | t }}</span>
        {%- endif -%}
      </div>
      <div class="feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte" style="margin-top:1rem">{{ section.settings.text }}</div>
        {%- if fp -%}
          <p class="feature__price">{% render 'price', price_product: fp %}</p>
          <a class="btn btn--primary" href="{{ fp.url }}">{{ 'products.product.view_product' | t }}</a>
        {%- else -%}
          <p style="color: var(--color-ink-soft); font-size: 0.9375rem">{{ 'sections.product_feature.select' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product feature",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image (optional — falls back to product image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For paws and noses" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A considered balm for the parts of your dog that meet the world. Fragrance-free, made for daily use, through every season.</p>" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false }
  ],
  "presets": [{ "name": "Product feature" }]
}
{% endschema %}
