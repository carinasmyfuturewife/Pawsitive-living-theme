    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 7h15l-1.6 8.2a1 1 0 0 1-1 .8H8.7a1 1 0 0 1-1-.8L5 3.8A1 1 0 0 0 4 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
  {%- when 'search' -%}
