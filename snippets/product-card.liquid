{% comment %}
  Product card — renders from the Shopify product object.
  No prices, titles, or inventory are hardcoded; everything is dynamic.
{% endcomment %}
{%- liquid
  assign card_product = product_card_product | default: product
  assign show_quick_add = show_quick_add | default: false
-%}
<div class="product-card">
  <a class="product-card__link" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    <div class="product-card__media">
      {%- if card_product.compare_at_price_max > card_product.price and card_product.available -%}
        <span class="badge badge--save">{{ 'products.product.save' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
      {%- if card_product.featured_media -%}
        {{ card_product.featured_media | image_url: width: 800 | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800',
          alt: card_product.featured_media.alt | default: card_product.title | escape
        }}
      {%- else -%}
        <span class="product-card__media--placeholder" aria-hidden="true">{{ card_product.title }}</span>
      {%- endif -%}
    </div>
    <div class="product-card__info">
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
      <p class="product-card__title">{{ card_product.title }}</p>
      <p class="product-card__price">{% render 'price', price_product: card_product %}</p>
    </div>
  </a>
  {%- if show_quick_add and card_product.available and card_product.variants.size == 1 -%}
    <form data-product-form action="/cart/add" method="post" class="product-card__quickadd">
      <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="btn btn--secondary btn--full" data-add-to-cart data-adding-text="{{ 'products.product.adding' | t }}">
        {{ 'products.product.quick_add' | t }}
      </button>
    </form>
  {%- endif -%}
</div>
