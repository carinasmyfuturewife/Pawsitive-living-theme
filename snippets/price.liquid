{% comment %} Dynamic price renderer. Never hardcodes amounts. {% endcomment %}
{%- liquid
  assign p = price_product | default: product
  assign variant = p.selected_or_first_available_variant
-%}
{%- if variant.compare_at_price > variant.price -%}
  <s>{{ variant.compare_at_price | money }}</s>
{%- endif -%}
{{ variant.price | money }}
